---
import { Icon } from "astro-icon/components";
import type { FriendLink } from "@/types/friendsConfig";

interface Props { item: FriendLink; publicTemplate?: boolean; }
const { item, publicTemplate = false } = Astro.props;
const kind = item.kind || "default";
---

<article
  class:list={["friend-card", "friend-card--" + kind]}
  data-friend-url={item.siteurl}
  data-friend-kind={kind}
  data-friend-tags={JSON.stringify(item.tags || [])}
  data-static-friend={!publicTemplate ? "" : undefined}
>
  <div class="friend-card-glow" aria-hidden="true" />
  <a class="friend-card-link" href={item.siteurl} target="_blank" rel="noopener noreferrer">
    <div class="friend-avatar">
      <img data-friend-avatar src={item.imgurl || undefined} alt="" loading="lazy" referrerpolicy="no-referrer" hidden={!item.imgurl} />
      <span data-avatar-fallback hidden={!!item.imgurl} aria-hidden="true">{Array.from(item.title)[0] || "友"}</span>
    </div>
    <div class="friend-card-copy">
      <div class="friend-card-title-row">
        <h3 data-friend-name>{item.title}</h3>
        {kind !== "default" && <span class="friend-kind">{kind === "owner" ? "本站" : "精选"}</span>}
        <Icon name="material-symbols:arrow-outward-rounded" class="friend-outward" />
      </div>
      <p data-friend-description title={item.desc}>{item.desc}</p>
      <div data-friend-tag-list class="friend-tags">
        {item.tags?.slice(0, 3).map((tag) => <span>{tag}</span>)}
      </div>
    </div>
  </a>
  {kind !== "owner" && <div class="friend-card-footer">
    <span class="friend-health" data-friend-health data-state="unchecked" title="尚无自动检测记录">未检测</span>
    <span class="friend-backlink" data-friend-backlink hidden />
    <button type="button" class="friend-preview-button" data-friend-preview hidden aria-label={"预览" + item.title + "的主页截图"}>
      <Icon name="material-symbols:photo-camera-outline" />
      <span>预览</span>
    </button>
  </div>}
</article>
