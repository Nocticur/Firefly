---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { FriendLink } from "@/types/friendsConfig";
import FriendCard from "./FriendCard.astro";

interface Props { items: FriendLink[]; owner?: FriendLink; }
const { items, owner } = Astro.props;
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();
const templateItem: FriendLink = { title: "", imgurl: "", desc: "", siteurl: "#", tags: [], weight: 0, enabled: true };
---

<public-friends>
  {owner?.enabled && <section class="friends-owner" aria-label="本站名片"><FriendCard item={owner} /></section>}
  <div class="friends-toolbar">
    <label class="friends-search">
      <Icon name="material-symbols:search" aria-hidden="true" />
      <input type="search" data-search aria-label={i18n(I18nKey.searchFriends)} placeholder="搜索站点、简介或标签…" />
    </label>
    <div data-tag-filters class="friends-filters" aria-label="友链标签筛选">
      <button type="button" data-tag="all" class="category-pill" data-active aria-pressed="true">{i18n(I18nKey.all)}</button>
      {allTags.map((tag) => <button type="button" data-tag={tag} class="category-pill" aria-pressed="false">{tag}</button>)}
    </div>
  </div>
  <div class="friends-health-summary">
    <p data-health-status role="status" aria-live="polite">尚无检测记录，所有友链均可正常浏览。</p>
    <button type="button" data-health-retry hidden>重新加载</button>
  </div>
  <p data-friends-status role="status" class="friends-source-status" />
  <section class="friends-section" data-health-section="active" aria-label="友链列表">
    <div class="friends-grid" data-friends-grid data-health-grid="active">
      {items.map((item) => <FriendCard item={item} />)}
    </div>
  </section>
  <section class="friends-section friends-section--pending" data-health-section="pending" hidden aria-labelledby="friends-pending-heading">
    <div class="friends-section-heading"><h3 id="friends-pending-heading">暂时失联 <span data-group-count="pending" /></h3><p>连续检测失败 1–6 次，等待下一次重逢。</p></div>
    <div class="friends-grid" data-health-grid="pending" />
  </section>
  <details class="friends-section friends-graveyard" data-health-section="graveyard" hidden>
    <summary><span>星际漂流 · 失联档案 <span data-group-count="graveyard" /></span><span class="friends-graveyard-hint">展开查看</span></summary>
    <p>连续检测失败 7 次以上。这里保留曾经相遇的地址，恢复访问后会自动回到列表。</p>
    <div class="friends-grid" data-health-grid="graveyard" />
  </details>
  <p data-search-empty class="friends-empty" hidden>{i18n(I18nKey.searchNoResults)}</p>
  {items.length === 0 && <p data-static-empty class="friends-empty">{i18n(I18nKey.friendsEmpty)}</p>}
  <p class="friends-health-note">检测来自 GitHub Actions 的最近一次运行；网络地区、站点防护可能影响结果，仅供参考。</p>
  <noscript><p class="friends-health-note">本站已展示全部发布友链。搜索、检测状态与截图预览需要 JavaScript。</p></noscript>
  <template data-friend-template><FriendCard item={templateItem} publicTemplate /></template>
</public-friends>

<script>
  import "./directory";
</script>
