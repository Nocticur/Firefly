---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { normalizeVideoSources } from "@/utils/background-media-utils";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
}

const { playerUrl, playerMode = "order" } = Astro.props;
const sources = normalizeVideoSources(playerUrl);
---

{sources.length > 0 && (
	<background-player id="bg-player" data-sources={JSON.stringify(sources)} data-mode={playerMode}>
		<div id="bg-player-overlay" class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0">
			<video id="bg-player-video" preload="none" playsinline aria-hidden="true" class="size-full object-cover"></video>
		</div>
		{sources.length > 1 && (
			<div class="bg-player-controls absolute bottom-4 left-4 z-30 flex items-center gap-1.5">
				<button type="button" data-video-prev class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white backdrop-blur-sm cursor-pointer" title={i18n(I18nKey.videoPrev)} aria-label={i18n(I18nKey.videoPrev)}>
					<Icon name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
				</button>
				<button type="button" data-video-next class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white backdrop-blur-sm cursor-pointer" title={i18n(I18nKey.videoNext)} aria-label={i18n(I18nKey.videoNext)}>
					<Icon name="material-symbols:skip-next-rounded" class="text-[1rem]" />
				</button>
			</div>
		)}
		<div data-video-toast role="status" aria-live="polite" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"></div>
		<template data-video-error>{i18n(I18nKey.videoLoadError)}</template>
	</background-player>
)}

<script>
	import { BackgroundPlayback } from "@/utils/background-media-utils";

	class BackgroundPlayerElement extends HTMLElement {
		private abort?: AbortController;
		private player?: BackgroundPlayback;
		private toastTimer?: ReturnType<typeof setTimeout>;

		connectedCallback() {
			const video = this.querySelector<HTMLVideoElement>("video");
			const overlay = this.querySelector<HTMLElement>("#bg-player-overlay");
			if (!video || !overlay || this.player) return;
			this.abort = new AbortController();
			const { signal } = this.abort;
			const toast = this.querySelector<HTMLElement>("[data-video-toast]");
			this.player = new BackgroundPlayback(video, JSON.parse(this.dataset.sources || "[]"), {
				mode: this.dataset.mode === "random" ? "random" : "order",
				onState: (playing) => {
					overlay.classList.toggle("opacity-0", !playing);
					overlay.classList.toggle("opacity-100", playing);
					document.body.toggleAttribute("data-bg-video-playing", playing);
					document.documentElement.toggleAttribute("data-bg-video-playing", playing);
					window.dispatchEvent(new CustomEvent("bg-player-state-change", { detail: { playing } }));
				},
				onError: () => {
					if (!toast) return;
					toast.textContent = this.querySelector("[data-video-error]")?.textContent || "";
					toast.classList.remove("opacity-0");
					clearTimeout(this.toastTimer);
					this.toastTimer = setTimeout(() => toast.classList.add("opacity-0"), 3000);
				},
			});
			window.addEventListener("bg-player-toggle", () => void this.player?.toggle(), { signal });
			window.addEventListener("wallpaperModeChange", (event) => {
				if ((event as CustomEvent).detail?.mode === "none") this.player?.pause();
			}, { signal });
			video.addEventListener("ended", () => this.player?.ended(), { signal });
			video.addEventListener("error", () => void this.player?.mediaError(), { signal });
			this.querySelector("[data-video-prev]")?.addEventListener("click", () => this.player?.previous(), { signal });
			this.querySelector("[data-video-next]")?.addEventListener("click", () => this.player?.next(), { signal });
		}

		disconnectedCallback() {
			this.abort?.abort();
			this.player?.pause();
			this.player = undefined;
			clearTimeout(this.toastTimer);
		}
	}
	if (!customElements.get("background-player")) customElements.define("background-player", BackgroundPlayerElement);
</script>

<style>
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) { opacity: 0 !important; transition: opacity 0.5s ease; }
	.bg-player-controls { opacity: 0; pointer-events: none; transition: opacity 0.2s ease; }
	:global([data-bg-video-playing]) .bg-player-controls { opacity: 1; pointer-events: auto; }
	@media (prefers-reduced-motion: reduce) {
		:global(#bg-player-overlay), .bg-player-controls { transition: none; }
	}
</style>
