---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownPanel from "@/components/common/DropdownPanel.astro";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
}

const { link, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;

const hasChildren = processedLink.children && processedLink.children.length > 0;

function isCurrentLink(candidate: NavBarLink): boolean {
	if (candidate.external || candidate.url === "#") return false;
	const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
	const linkPath = new URL(url(candidate.url), Astro.url).pathname.replace(/\/+$/, "") || "/";
	return currentPath === linkPath;
}

const isActive = hasChildren
	? processedLink.children?.some(isCurrentLink)
	: isCurrentLink(processedLink);
---

<div class:list={["dropdown-container", className]} data-dropdown data-dropdown-open="false">
	{hasChildren ? (
		<button 
			type="button"
			class="navbar-link btn-plain scale-animation rounded-lg h-10 font-bold active:scale-95 dropdown-trigger relative"
			aria-expanded="false"
			aria-haspopup="true"
			data-dropdown-trigger
			data-navbar-group
			data-active={isActive ? "true" : undefined}
		>
			<div class="navbar-link-inner flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] navbar-icon" />}
				{processedLink.name}
				<Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow" />
			</div>
		</button>
		<div class="dropdown-menu" data-dropdown-menu inert aria-hidden="true">
			<DropdownPanel class="dropdown-content">
				{processedLink.children?.map((child, index) => (
					<DropdownItem
						href={child.external ? child.url : url(child.url)}
						target={child.external ? "_blank" : undefined}
						reload={child.url === "/admin/"}
						isLast={index === (processedLink.children?.length || 0) - 1}
						class="dropdown-item focus-ring-inset h-10"
					>
						{child.icon && <Icon name={child.icon} class="text-[1.25rem] mr-3 navbar-icon" />}
						<span>{child.name}</span>
						{child.external && (
							<Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
						)}
					</DropdownItem>
				))}
			</DropdownPanel>
		</div>
	) : (
		<a 
			aria-label={processedLink.name} 
			aria-current={isActive ? "page" : undefined}
			href={processedLink.external ? processedLink.url : url(processedLink.url)} 
			target={processedLink.external ? "_blank" : null}
			class="navbar-link btn-plain scale-animation rounded-lg h-10 font-bold active:scale-95"
			data-navbar-link
			data-nav-href={processedLink.external ? undefined : url(processedLink.url)}
			data-astro-reload={processedLink.url === "/admin/" || undefined}
			data-no-swup={processedLink.url === "/admin/" || undefined}
		>
			<div class="navbar-link-inner flex items-center gap-1.5">
				{processedLink.icon && <Icon name={processedLink.icon} class="text-[1.1rem] navbar-icon" />}
				{processedLink.name}
				{processedLink.external && <Icon name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 pointer-events-none z-50;
		visibility: hidden;
	}

	.dropdown-container[data-dropdown-open="true"] .dropdown-menu {
		@apply pointer-events-auto;
		visibility: visible;
	}

	.dropdown-container[data-dropdown-open="true"] .dropdown-arrow {
		@apply rotate-180;
	}

	/* 移动端隐藏下拉菜单 */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	function setDropdownOpen(dropdown: HTMLElement, open: boolean) {
		const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
		const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
		if (!trigger || !menu) return;
		dropdown.dataset.dropdownOpen = String(open);
		if (!open) dropdown.dataset.dropdownClickOpen = "false";
		trigger.setAttribute("aria-expanded", String(open));
		menu.inert = !open;
		menu.setAttribute("aria-hidden", String(!open));
	}

	function initializeDropdowns() {
		document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
			const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
			const items = dropdown.querySelectorAll<HTMLElement>(".dropdown-item");
			if (!trigger || dropdown.dataset.dropdownBound === "true") return;
			dropdown.dataset.dropdownBound = "true";
			setDropdownOpen(dropdown, false);

			// Enter/Space 使用按钮原生 click，只有这一处切换开关。
			trigger.addEventListener("click", () => {
				const open = dropdown.dataset.dropdownClickOpen !== "true";
				dropdown.dataset.dropdownClickOpen = String(open);
				setDropdownOpen(dropdown, open);
			});
			dropdown.addEventListener("pointerenter", (event) => {
				if (event.pointerType !== "touch") setDropdownOpen(dropdown, true);
			});
			dropdown.addEventListener("pointerleave", () => {
				if (!dropdown.contains(document.activeElement)) setDropdownOpen(dropdown, false);
			});
			dropdown.addEventListener("focusout", (event) => {
				if (!(event.relatedTarget instanceof Node) || !dropdown.contains(event.relatedTarget)) {
					setDropdownOpen(dropdown, false);
				}
			});
			trigger.addEventListener("keydown", (event) => {
				if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
				event.preventDefault();
				setDropdownOpen(dropdown, true);
				items[event.key === "ArrowUp" ? items.length - 1 : 0]?.focus();
			});
			items.forEach((item, index) => {
				item.addEventListener("keydown", (event) => {
					if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
					event.preventDefault();
					const offset = event.key === "ArrowDown" ? 1 : -1;
					items[(index + offset + items.length) % items.length]?.focus();
				});
				item.addEventListener("click", () => setDropdownOpen(dropdown, false));
			});
			dropdown.addEventListener("keydown", (event) => {
				if (event.key !== "Escape") return;
				event.preventDefault();
				setDropdownOpen(dropdown, false);
				trigger.focus();
			});
		});
	}

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Node)) return;
		const target = event.target;
		document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
			if (!dropdown.contains(target)) setDropdownOpen(dropdown, false);
		});
	});
	initializeDropdowns();
	document.addEventListener("astro:page-load", initializeDropdowns);
</script>
