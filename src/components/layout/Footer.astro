---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import ci from "ci-info";
import animalsImage from "@/assets/images/footer-animals.webp";
import { footerConfig, licenseConfig, profileConfig, siteConfig } from "@/config";
import { detectBuildPlatform } from "@/utils/build-platform";
import { getFooterRuntime } from "@/utils/footer-runtime";
import { url } from "@/utils/url-utils";

import pkg from "../../../package.json";
import "@/styles/footer.css";

const currentYear = new Date().getFullYear();
const initialRuntime = getFooterRuntime(siteConfig.siteStartDate);
let customFooterHtml = "";
try {
	customFooterHtml = fs
		.readFileSync(path.join(process.cwd(), "src/config/FooterConfig.html"), "utf-8")
		.replace(/<!--[\s\S]*?-->/g, "")
		.trim();
} catch (error) {
	console.warn(
		"FooterConfig.html 读取失败:",
		error instanceof Error ? error.message : String(error),
	);
}

const github = profileConfig.links.find(
	(link) => link.icon.includes("github") || link.url.includes("github.com/"),
);
const bilibili = profileConfig.links.find(
	(link) => link.icon.includes("bilibili") || link.url.includes("bilibili.com/"),
);

const socials = [
	{
		name: "博客",
		icon: "material-symbols:home-outline",
		url: url("/"),
		external: false,
	},
	...(github
		? [{ name: "GitHub", icon: "simple-icons:github", url: github.url, external: true }]
		: []),
	...(bilibili
		? [{ name: "B站", icon: "fa7-brands:bilibili", url: bilibili.url, external: true }]
		: []),
];

const buildPlatform = detectBuildPlatform({
	env: process.env,
	isCI: ci.isCI,
	ciName: ci.name,
	isDev: import.meta.env.DEV,
});
const platformLabel = buildPlatform.includes("Cloudflare")
	? "Cloudflare"
	: buildPlatform.includes("EdgeOne")
		? "EdgeOne"
		: buildPlatform;
const licenseLabel = licenseConfig.name
	.replace(/^CC\s+/, "")
	.replace(/\s+\d+(?:\.\d+)?$/, "");
const techStack = [
	{ label: "Astro", tone: "violet", icon: "simple-icons:astro" },
	{ label: "Tailwind CSS", tone: "cyan", icon: "simple-icons:tailwindcss" },
	{ label: "Svelte", tone: "orange", icon: "simple-icons:svelte" },
	{ label: platformLabel, tone: "blue", icon: "material-symbols:cloud-outline" },
	{ label: "Pagefind", tone: "green", icon: "material-symbols:search-rounded" },
];
---

<!-- Adapted from Seasir-Hyde/Firefly-hyde; retain this layer outside Swup. -->
<div class="site-footer-stage pointer-events-auto" data-pagefind-ignore="all">
	<div class="site-footer-stage__separator transition border-t border-black/10 dark:border-white/15 border-dashed"></div>
	<section class="site-footer-kept-layers" aria-label="页脚装饰与技术栈">
		<div class="site-footer-animals">
			<img src={animalsImage.src} alt="八位可爱的动漫角色并排趴在页脚上方" width="2170" height="305" loading="lazy" />
		</div>

		<div class="site-footer-stack" aria-label="本站使用的技术">
			{techStack.map((item) => (
				<span class={`site-footer-stack__badge site-footer-stack__badge--${item.tone}`}>
					<Icon name={item.icon} aria-hidden="true" />
					<span>{item.label}</span>
				</span>
			))}
			<span class="site-footer-stack__badge site-footer-stack__badge--quiet">© <span data-footer-year>{currentYear}</span>{licenseConfig.enable && ` / ${licenseLabel}`}</span>
		</div>

	</section>

	<footer id="site-footer" class="site-footer transition" aria-label="网站页脚">
		<div class="site-footer__decor" aria-hidden="true">
			<div class="site-footer__planet site-footer__planet--left"><span></span></div>
			<div class="site-footer__planet site-footer__planet--right"></div>

			<svg class="site-footer__waves" viewBox="0 0 2048 430" preserveAspectRatio="none">
				<defs>
					<linearGradient id="site-footer-wave-left" x1="0" y1="0" x2="1" y2="0">
						<stop offset="0" stop-color="#ffffff" stop-opacity="0.88"></stop>
						<stop offset="0.58" stop-color="#8bbcff" stop-opacity="0.64"></stop>
						<stop offset="1" stop-color="#2c86f5" stop-opacity="0"></stop>
					</linearGradient>
					<linearGradient id="site-footer-wave-right" x1="1" y1="0" x2="0" y2="0">
						<stop offset="0" stop-color="#ffffff" stop-opacity="0.9"></stop>
						<stop offset="0.58" stop-color="#8bbcff" stop-opacity="0.62"></stop>
						<stop offset="1" stop-color="#2c86f5" stop-opacity="0"></stop>
					</linearGradient>
					<radialGradient id="site-footer-node" cx="50%" cy="50%" r="50%">
						<stop offset="0" stop-color="#ffffff"></stop>
						<stop offset="0.35" stop-color="#9fd3ff"></stop>
						<stop offset="1" stop-color="#2f8df7" stop-opacity="0"></stop>
					</radialGradient>
				</defs>

				<g fill="none" stroke="url(#site-footer-wave-left)" stroke-width="1.6">
					<path d="M-30 170 C 154 170, 190 316, 356 321 C 500 326, 545 230, 684 245 C 776 255, 817 320, 938 338"></path>
					<path d="M-28 202 C 126 205, 192 347, 355 351 C 500 356, 563 264, 702 279 C 790 288, 836 340, 944 354"></path>
					<path d="M-22 237 C 122 242, 201 374, 360 378 C 514 382, 584 303, 718 315 C 805 323, 852 360, 952 370"></path>
					<path d="M-14 274 C 121 279, 217 399, 375 403 C 526 406, 601 342, 735 349 C 824 354, 870 378, 960 385"></path>
					<path d="M-4 310 C 136 314, 236 416, 393 420 C 545 423, 617 377, 752 381 C 839 383, 888 392, 972 397"></path>
				</g>

				<g fill="none" stroke="url(#site-footer-wave-right)" stroke-width="1.6">
					<path d="M2078 126 C 1882 128, 1818 305, 1655 318 C 1507 330, 1456 246, 1314 258 C 1214 266, 1170 329, 1062 342"></path>
					<path d="M2075 160 C 1889 166, 1826 337, 1654 346 C 1502 354, 1439 277, 1303 291 C 1210 301, 1157 345, 1055 358"></path>
					<path d="M2070 197 C 1893 204, 1828 365, 1651 372 C 1500 378, 1421 312, 1287 326 C 1195 336, 1144 364, 1048 373"></path>
					<path d="M2064 237 C 1890 244, 1823 390, 1644 396 C 1491 401, 1406 349, 1275 359 C 1182 366, 1129 381, 1038 387"></path>
					<path d="M2058 280 C 1882 286, 1806 413, 1627 419 C 1475 423, 1394 382, 1260 389 C 1171 394, 1118 398, 1028 402"></path>
				</g>

				<g opacity="0.96">
					<circle cx="164" cy="315" r="4.5" fill="url(#site-footer-node)"></circle>
					<circle cx="428" cy="383" r="6" fill="url(#site-footer-node)"></circle>
					<circle cx="548" cy="352" r="3.5" fill="url(#site-footer-node)"></circle>
					<circle cx="1588" cy="364" r="5.5" fill="url(#site-footer-node)"></circle>
					<circle cx="1838" cy="307" r="4" fill="url(#site-footer-node)"></circle>
					<circle cx="1944" cy="260" r="3" fill="url(#site-footer-node)"></circle>
				</g>
			</svg>

			<span class="site-footer__star site-footer__star--one"></span>
			<span class="site-footer__star site-footer__star--two"></span>
			<span class="site-footer__star site-footer__star--three"></span>
			<span class="site-footer__star site-footer__star--four"></span>
			<span class="site-footer__star site-footer__star--five"></span>
		</div>

		<div class="site-footer__content">
			<nav class="site-footer__nav" aria-label="页脚快捷导航">
				{socials.map((social) => (
					<a
						class="site-footer__nav-link"
						href={social.url}
						target={social.external ? "_blank" : undefined}
						rel={social.external ? "noreferrer" : undefined}
					>
						<Icon name={social.icon} aria-hidden="true" />
						<span>{social.name}</span>
					</a>
				))}
			</nav>

			{initialRuntime && <div class="site-footer__runtime" aria-label="网站运行时间">
				<div class="site-footer__clock" aria-hidden="true">
					<span class="site-footer__clock-orbit"></span>
					<svg viewBox="0 0 100 100">
						<circle cx="50" cy="50" r="39"></circle>
						<path d="M50 27v25l17 10"></path>
						<circle cx="50" cy="52" r="4.5"></circle>
					</svg>
				</div>
				<time data-footer-runtime data-start-date={siteConfig.siteStartDate} datetime={siteConfig.siteStartDate}>
					本站已运行 <strong data-unit="days">{initialRuntime.days}</strong> 天 <strong data-unit="hours">{initialRuntime.hours}</strong> 小时 <strong data-unit="minutes">{initialRuntime.minutes}</strong> 分 <strong data-unit="seconds">{initialRuntime.seconds}</strong> 秒
				</time>
				<span class="site-footer__runtime-sparkle" aria-hidden="true">✦</span>
			</div>}

			{footerConfig.icp && <div class="site-footer__records" aria-label="网站备案信息">
				<a href={footerConfig.icpUrl} target="_blank" rel="noreferrer">
					<svg class="site-footer__shield" viewBox="0 0 36 40" aria-hidden="true">
						<path d="M18 1.5 33 7v12.1c0 9.4-6.3 15.8-15 19.4C9.3 34.9 3 28.5 3 19.1V7z"></path>
						<path class="site-footer__shield-mark" d="m10.2 19.7 5.1 5.1 10.8-12"></path>
					</svg>
					<span>{footerConfig.icp}</span>
				</a>
			</div>}

			{footerConfig.showTraffic && <div class="site-footer__traffic" aria-label="网站访问统计">
				<span class="site-footer__traffic-item">
					<span>今日访客：</span>
					<strong>--</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>今日访问：</span>
					<strong>--</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>本站访客：</span>
					<strong>--</strong>
				</span>
				<i aria-hidden="true">|</i>
				<span class="site-footer__traffic-item">
					<span>本站访问：</span>
					<strong>--</strong>
				</span>
			</div>}

			{customFooterHtml && <div class="site-footer__custom" set:html={customFooterHtml} />}

			<div class="site-footer__divider" aria-hidden="true">
				<span></span>
				<i>✦</i>
				<span></span>
			</div>

			<div class="site-footer__meta">
				<span>© <span id="copyright-year" data-footer-year>{currentYear}</span> {profileConfig.name}. All Rights Reserved.</span>
				<span class="site-footer__meta-separator" aria-hidden="true"></span>
				<a href={url("rss.xml")}>
					<Icon name="material-symbols:rss-feed-rounded" aria-hidden="true" />
					<span>RSS</span>
				</a>
				<span class="site-footer__meta-separator" aria-hidden="true"></span>
				<a href={url("atom.xml")}>
					<Icon name="fa7-solid:atom" aria-hidden="true" />
					<span>Atom</span>
				</a>
				<span class="site-footer__meta-separator" aria-hidden="true"></span>
				<a href={url("sitemap-index.xml")}>
					<svg viewBox="0 0 32 32" aria-hidden="true">
						<rect x="13" y="2.5" width="6" height="6" rx="1.5"></rect>
						<rect x="3" y="23.5" width="6" height="6" rx="1.5"></rect>
						<rect x="13" y="23.5" width="6" height="6" rx="1.5"></rect>
						<rect x="23" y="23.5" width="6" height="6" rx="1.5"></rect>
						<path d="M16 8.5v7M6 23.5v-5h20v5M16 15.5v8"></path>
					</svg>
					<span>Sitemap</span>
				</a>
			</div>

			<div class="site-footer__powered">
				<span class="site-footer__powered-dots" aria-hidden="true">• • •</span>
				<span class="site-footer__powered-star" aria-hidden="true">✦</span>
				<span>Powered by</span>
				<a href="https://astro.build" target="_blank" rel="noreferrer">Astro</a>
				<span aria-hidden="true">&</span>
				<a
					class="site-footer__powered-name"
					href="https://github.com/CuteLeaf/Firefly"
					target="_blank"
					rel="noreferrer">Firefly Theme @ V{pkg.version}</a>
				<span class="site-footer__powered-star" aria-hidden="true">✦</span>
				<span class="site-footer__powered-dots" aria-hidden="true">• • •</span>
			</div>
		</div>
	</footer>
</div>

<script>
	import { getFooterRuntime } from "@/utils/footer-runtime";

	let interval: number | undefined;

	const renderFooter = () => {
		const year = String(new Date().getFullYear());
		for (const element of document.querySelectorAll("[data-footer-year]")) {
			element.textContent = year;
		}
		const time = document.querySelector<HTMLElement>("[data-footer-runtime]");
		if (!time) return;
		const runtime = getFooterRuntime(time.dataset.startDate);
		if (!runtime) return;
		for (const [unit, value] of Object.entries(runtime)) {
			const element = time.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
			if (element) element.textContent = String(value);
		}
	};

	const startFooter = () => {
		renderFooter();
		if (interval === undefined) interval = window.setInterval(renderFooter, 1000);
	};
	const stopFooter = () => {
		window.clearInterval(interval);
		interval = undefined;
	};

	startFooter();
	window.addEventListener("pagehide", stopFooter);
	window.addEventListener("pageshow", startFooter);
</script>
