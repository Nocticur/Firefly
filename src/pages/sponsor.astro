---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18n } from "@/utils/date-utils";
import { isPageAvailable } from "@/utils/page-availability";
import { getEnabledSponsorMethods } from "@/utils/sponsor-utils";
import { url } from "@/utils/url-utils";
import "@/styles/pages/common.css";
import "@/styles/pages/sponsor.css";

if (!isPageAvailable("sponsor", siteConfig.pages, sponsorConfig.enable)) {
	return Astro.redirect("/404/");
}

const title = sponsorConfig.title || i18n(I18nKey.sponsorTitle);
const methods = getEnabledSponsorMethods(sponsorConfig.methods);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);
const sponsors = sponsorConfig.sponsors || [];
---

<MainGridLayout title={title} description={description}>
	<section class="card-base sponsor-page" aria-labelledby="sponsor-title">
		<div class="page-heading">
			<div class="page-icon" aria-hidden="true"><Icon name="material-symbols:favorite" /></div>
			<div><h1 id="sponsor-title">{title}</h1><p>{description}</p></div>
		</div>
		{sponsorConfig.usage && <p class="sponsor-usage"><Icon name="material-symbols:info-outline" aria-hidden="true" />{sponsorConfig.usage}</p>}
		{methods.length > 0 ? (
			<div class="sponsor-methods">
				{methods.map((method) => (
					<article class="sponsor-method" data-type={method.type}>
						<div class="sponsor-method-heading">
							{method.icon && <Icon name={method.icon} aria-hidden="true" />}
							<h2>{method.name}</h2>
						</div>
						{method.description && <p>{method.description}</p>}
						{method.type === "qrcode" ? (
							<figure class="sponsor-qr">
								<ImageWrapper src={method.image.trim()} alt={`${method.name}收款二维码`} class="sponsor-qr-image" width={200} height={200} sizes="200px" fadeIn={false} showLqip={false} showOverlay={false} />
								<figcaption>{i18n(I18nKey.scanToSponsor)}</figcaption>
							</figure>
						) : (
							<a class="sponsor-link" href={method.url.trim()} target="_blank" rel="noopener noreferrer">
								<span>{i18n(I18nKey.sponsorGoTo)}</span><Icon name="material-symbols:open-in-new" aria-hidden="true" />
							</a>
						)}
					</article>
				))}
			</div>
		) : <p class="sponsor-empty" role="status">本站暂未开放打赏，感谢你的阅读与支持。</p>}
	</section>
	{sponsorConfig.showSponsorsList !== false && (
		<section class="card-base sponsor-page sponsor-list-section" aria-labelledby="sponsor-list-title">
			<div class="sponsor-list-heading"><h2 id="sponsor-list-title">{i18n(I18nKey.sponsorList)}</h2>{sponsors.length > 0 && <span>{sponsors.length} 位</span>}</div>
			{sponsors.length > 0 ? (
				<ul class="sponsor-grid">
					{sponsors.map((sponsor) => {
						const date = sponsor.date && Number.isFinite(Date.parse(sponsor.date)) ? sponsor.date : undefined;
						return (
							<li class="sponsor-person">
								<span class="sponsor-avatar" aria-hidden="true">
									<span>{Array.from(sponsor.name.trim())[0] || "?"}</span>
									{sponsor.avatar && <img src={url(sponsor.avatar)} alt="" width="40" height="40" loading="lazy" onerror="this.remove()" />}
								</span>
								<div class="sponsor-person-info"><span class="sponsor-name">{sponsor.name}</span>{date && <time datetime={date}>{formatDateI18n(date)}</time>}</div>
								{sponsor.amount && <span class="sponsor-amount">{sponsor.amount}</span>}
							</li>
						);
					})}
				</ul>
			) : <p class="sponsor-empty">{i18n(I18nKey.sponsorEmpty)}</p>}
		</section>
	)}
</MainGridLayout>
