# 逐项来源：docs/nocticur/environment-variables.md；部署步骤：docs/nocticur/deployment.md。
# 复制后按当前环境填写；不要提交实际值。
# Vercel 使用仓库根项目 firefly 一起部署博客、/admin/ 和 /api/，全部变量填在该项目。
# 完整托管构建命令为根目录 pnpm build:vercel；不再创建独立 firefly-admin 项目。
# Vercel 自行提供 VERCEL、VERCEL_ENV、VERCEL_GIT_COMMIT_SHA，勿用本模板覆盖。
# APP_ENV 只能为 development / preview / production，并须与 VERCEL_ENV 一致。
APP_ENV=
GITHUB_REPOSITORY=Nocticur/Firefly
# 后台只验证此密码，正确后直接进入；支持 3～10 个字符，后台自动生成加盐 scrypt 哈希校验。
# 仅服务端读取；不要加 PUBLIC_ / VITE_ 前缀。各环境使用不同密码。
ADMIN_ENTRY_PASSWORD=
ADMIN_ORIGIN=https://blog.mourn.top
PUBLIC_SITE_ORIGIN=https://blog.mourn.top
ADMIN_DEV_ORIGIN=
PUBLIC_DEV_ORIGIN=
ADMIN_PREVIEW_ORIGIN=
PUBLIC_PREVIEW_ORIGIN=

# Neon / PostgreSQL：生产、预览、开发须隔离。不要将生产连接配置到 Preview。
ADMIN_PRODUCTION_DATABASE_URL=
ADMIN_PREVIEW_DATABASE_URL=
ADMIN_DEVELOPMENT_DATABASE_URL=
# 仅自动化测试使用隔离数据库；维护测试的数据库角色需可创建临时测试数据库。
ADMIN_TEST_DATABASE_URL=
# 恢复演练库必须使用不同数据库名，且预先应用全部迁移。
RESTORE_DATABASE_URL=

# GitHub App 用于仓库导入、核查和发布，不参与登录；仅安装到 Nocticur/Firefly，Contents: read/write。
# 私钥通过平台秘密字段填写原始多行 PEM 或带字面量 \n 的 PEM。
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# 仅统一 firefly 项目 Production：核验当前同一项目的生产部署。
VERCEL_TOKEN=
VERCEL_BLOG_PROJECT_ID=prj_lIQjUgfWVL6f8XUdyOK7wsttWJZG
VERCEL_TEAM_ID=team_09F7sDf0p1hCd9apVLcHC2iU
# 仅部署保护阻止核验时配置；保护绕过值仍是秘密。
VERCEL_AUTOMATION_BYPASS_SECRET=

# 每个环境各有私有和公开 Blob store，令牌不能跨环境复用。
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_PUBLIC_READ_WRITE_TOKEN=
ADMIN_PREVIEW_PRIVATE_BLOB_TOKEN=
ADMIN_PREVIEW_PUBLIC_BLOB_TOKEN=
ADMIN_DEV_PRIVATE_BLOB_TOKEN=
ADMIN_DEV_PUBLIC_BLOB_TOKEN=
# 外链导入仅接受这里明确列出的 HTTPS 主机名，逗号分隔，无通配符。
MEDIA_IMPORT_HOSTS=

# Turnstile 公钥 PUBLIC_TURNSTILE_SITE_KEY 在同一项目的构建变量中填写；只有公钥可公开。
# 当前管理环境对应的 Turnstile 私钥与访客摘要密钥。
TURNSTILE_SECRET_KEY=
INTERACTION_HASH_SECRET=
# 默认关闭公开评论 API。仅与博客 commentConfig.type=nocticur 一同显式启用。
# 友链申请不依赖此开关；小组件 action 分别为 comments / friend_request。
ENABLE_PUBLIC_COMMENTS=false

# 仅 Production 填写并显式启用正式邮件。
RESEND_API_KEY=
RESEND_FROM=
# 签名回调入口为 https://blog.mourn.top/api/webhooks/resend。
RESEND_WEBHOOK_SECRET=
# Vercel Cron 使用 Authorization: Bearer <CRON_SECRET>。
CRON_SECRET=

# 默认关闭可选正式服务。免费部署使用 Hobby / Free，不升级套餐或绑定付费附加项。
# 仅 Production 在受控验收、确认免费额度后按需设置为 true。
ENABLE_PRODUCTION_PUBLISH=
ENABLE_PRODUCTION_EMAIL=
ENABLE_PRODUCTION_MAINTENANCE=
