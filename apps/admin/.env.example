# 无数据库配置：博客和 /admin/ 一起部署在根 Vercel 项目 firefly。
# 详细说明：docs/nocticur/environment-variables.md
# 只在 Production 填生产值；不要把秘密提交到 Git。
ADMIN_ENTRY_PASSWORD=
BLOB_PRIVATE_READ_WRITE_TOKEN=
IMGBED_BASE_URL=https://image.nocticur.eu.cc
IMGBED_API_TOKEN=

# 导入和发布文章时，按需取消注释并填服务商凭据。
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# VERCEL_TOKEN=


# 接收友链申请或启用本站评论时需要同一 Turnstile 小组件的公钥与私钥。
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# 生产发布和维护在后台“服务设置”中开启，默认全部关闭。
# 开关保存在私有 JSON 文件中；不再使用 ENABLE_PRODUCTION_* 环境变量。

# 以下为可选服务，仅使用时添加，详见文档。
# 每日维护：CRON_SECRET；恢复不再需要单独数据库。
# 开发：ADMIN_DEV_PRIVATE_BLOB_TOKEN；预览：ADMIN_PREVIEW_PRIVATE_BLOB_TOKEN。
# 每个非生产环境还需自己的密码及所用服务的隔离凭据。
# Vercel 自动提供环境和预览地址，本地默认 development，无需 APP_ENV。
# 不用手填仓库名、生产 origin、GitHub installation ID 或 Vercel project ID。
