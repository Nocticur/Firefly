# 以 Git 为唯一数据源：博客、/admin/ 和 /api/ 一起部署在根 Vercel 项目 firefly。
# 详细说明：docs/nocticur/environment-variables.md
# 只在 Production 填生产值；不要把秘密提交到 Git。

# 必填：后台登录密码（3～10 个字符，服务端加盐 scrypt 校验）。
ADMIN_ENTRY_PASSWORD=

# 必填：GitHub 细粒度个人访问令牌（Personal access token）。
# 权限：Contents = Read and write（读写文章与设置）；Metadata = Read（GitHub 强制）。
# 只授权目标仓库，例如 Nocticur/blog。令牌只放在 Vercel 环境变量里，不要写进仓库。
# GITHUB_TOKEN=
# 目标仓库与分支；不填时默认 Nocticur/Firefly 与 master。
# GITHUB_REPOSITORY=Nocticur/blog
# GITHUB_BRANCH=master

# 可选：登录会话签名密钥（至少 32 字符）。
# 不填时自动由 ADMIN_ENTRY_PASSWORD 派生；更换密码即让所有旧会话失效。
# ADMIN_SESSION_SECRET=

# 图片上传与外链导入走 CloudFlare-ImgBed；使用媒体库时 IMGBED_API_TOKEN 必填。
IMGBED_BASE_URL=https://image.nocticur.eu.cc
IMGBED_API_TOKEN=

# 可选：GitHub App 仅作为 PAT 缺失时的回退，通常不需要配置。
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_INSTALLATION_ID=        # 可选，自动查询

# 可选：发布后触发 Vercel 重新部署。
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=                # 可选，团队项目
# VERCEL_AUTOMATION_BYPASS_SECRET=  # 可选，生产域名启用 Deployment Protection 时

# 接收友链申请或启用本站评论时需要同一 Turnstile 小组件的公钥与私钥。
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# INTERACTION_HASH_SECRET=       # 可选，默认复用 TURNSTILE_SECRET_KEY
# ENABLE_PUBLIC_COMMENTS=        # 可选 true/false
# MEDIA_IMPORT_HOSTS=            # 可选，逗号分隔；默认博客域名与已发布图片主机

# 每日维护 Cron：启用时必须配置，接口以 Bearer 校验。
# CRON_SECRET=

# 生产发布和维护在后台“服务设置”中开启，默认全部关闭。
# 不再需要数据库：文章与设置来自 Git 仓库，评论/友链等少量写入保存在后台状态中。
# Cloudflare KV 已废弃，仅在显式配置时才会被使用；不配置时后台照常读写仓库内容。
# Vercel 自动提供 VERCEL_ENV、VERCEL_URL、VERCEL_PROJECT_PRODUCTION_URL、VERCEL_PROJECT_ID、
# VERCEL_GIT_COMMIT_SHA、VERCEL；无需手填仓库名、GitHub installation ID 或 Vercel project ID。
# 旧变量已废弃：BLOB_*、CF_*、KV_PROVIDER、KV_REST_API_URL/TOKEN、UPSTASH_REDIS_REST_URL/TOKEN、
# DATABASE_URL、POSTGRES_*；残留配置不会再被读取。
