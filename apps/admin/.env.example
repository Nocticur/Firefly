# Firefly 博客后台环境变量清单
# 博客、/admin/ 与 /api/ 一起部署在同一个 Vercel 项目（本项目仓库 Nocticur/Firefly）。
# 详细说明：docs/nocticur/environment-variables.md
# 只在 Production 填生产值；不要把任何密钥提交到 Git。

# ─────────────────────────────────────────────
# 必填（只有 2 个）
# ─────────────────────────────────────────────

# 后台登录密码（3～10 个字符，服务端加盐 scrypt 校验）。
ADMIN_ENTRY_PASSWORD=

# GitHub 细粒度个人访问令牌：后台读写仓库的文章与设置。
# 生成：https://github.com/settings/personal-access-tokens/new
# 管理：https://github.com/settings/personal-access-tokens
# 权限：Contents = Read and write；Metadata = Read（GitHub 强制）
# 授权范围：只勾选 Nocticur/Firefly
# 必须设为 Sensitive；改完必须 Redeploy 才生效。
# 本地自检（不会打印令牌）：node scripts/check-github-access.mjs
GITHUB_TOKEN=

# ─────────────────────────────────────────────
# 可选：持久化后台状态（Cloudflare KV，3 个）
# ─────────────────────────────────────────────
# 不配置：文章与设置照常从 Git 读写并可提交，但草稿、版本历史、评论、
#         友链审核、媒体记录只存在进程内存，重启或多实例访问就会丢失。
# 配置后：上述状态写入 KV；某次发布核验完成后，已入库文章的本地版本副本
#         会自动清理，避免状态文档随发布不断变大。
# 获取方式：Cloudflare Dashboard → Storage & Databases → KV → 创建命名空间，
#           账户 ID 在账户概览页，API Token 在 My Profile → API Tokens 创建
#           （权限：Account → Workers KV Storage → Edit）。
# CF_ACCOUNT_ID=
# CF_KV_NAMESPACE_ID=
# CF_API_TOKEN=

# 可选：开发/预览使用独立 KV 时才需要（与生产同名变量加前缀，防止串数据）。
# 不配置时开发/预览使用内存，不影响生产。
# ADMIN_DEV_CF_ACCOUNT_ID= / ADMIN_DEV_CF_KV_NAMESPACE_ID= / ADMIN_DEV_CF_API_TOKEN=
# ADMIN_PREVIEW_CF_ACCOUNT_ID= / ADMIN_PREVIEW_CF_KV_NAMESPACE_ID= / ADMIN_PREVIEW_CF_API_TOKEN=

# ─────────────────────────────────────────────
# 可选：仓库与分支（默认值就是本项目，通常无需填写）
# ─────────────────────────────────────────────
# 一旦填写，令牌必须对“这个仓库”有权限，否则 GitHub 返回 404。
# GITHUB_REPOSITORY=Nocticur/Firefly
# GITHUB_BRANCH=master

# ─────────────────────────────────────────────
# 可选：图片（CloudFlare-ImgBed）
# ─────────────────────────────────────────────
# 使用后台媒体库时 IMGBED_API_TOKEN 必填；图片不进 Vercel Blob。
IMGBED_BASE_URL=https://image.nocticur.eu.cc
IMGBED_API_TOKEN=

# ─────────────────────────────────────────────
# 可选：生产发布与每日维护
# ─────────────────────────────────────────────
# 发布后在 Vercel 核验生产部署；只有设置它才能在生产环境发布。
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=                      # 仅团队项目需要
# VERCEL_AUTOMATION_BYPASS_SECRET=     # 仅生产域名开启 Deployment Protection 时需要
# 每日维护 Cron 的 Bearer 密钥；启用定时维护时必填。
# CRON_SECRET=

# ─────────────────────────────────────────────
# 可选：公开互动（评论 / 友链申请）
# ─────────────────────────────────────────────
# 两者来自同一个 Turnstile 小组件。
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# INTERACTION_HASH_SECRET=             # 默认复用 TURNSTILE_SECRET_KEY
# ENABLE_PUBLIC_COMMENTS=              # 默认跟随 src/config/commentConfig.ts
# MEDIA_IMPORT_HOSTS=                  # 默认取站点域名与已发布图床域名

# ─────────────────────────────────────────────
# 可选：会话与开发
# ─────────────────────────────────────────────
# 会话签名密钥（≥32 字符）；不填则由 ADMIN_ENTRY_PASSWORD 派生。
# 设置后轮换密码不再使旧会话失效，独立控制会话有效期。
# ADMIN_SESSION_SECRET=
# ADMIN_DEV_ORIGIN=http://localhost:3000
# PUBLIC_DEV_ORIGIN=http://localhost:4321

# ─────────────────────────────────────────────
# 可选：AI 生成摘要
# ─────────────────────────────────────────────
# 任何兼容 OpenAI chat/completions 的服务都能用，只改这三个变量，不用改代码。
# AI_API_KEY 是唯一必填项；配好并 Redeploy 后，文章编辑页摘要框旁会多出「AI 生成摘要」按钮。
# AI_API_KEY=                         # 必填，缺失时按钮提示「未配置 AI_API_KEY」
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# ─────────────────────────────────────────────
# 已废弃，不要配置
# ─────────────────────────────────────────────
# Vercel Blob：BLOB_PRIVATE_READ_WRITE_TOKEN、BLOB_PUBLIC_READ_WRITE_TOKEN
# 旧键值存储：KV_PROVIDER、KV_REST_API_URL、KV_REST_API_TOKEN
# Upstash：UPSTASH_REDIS_REST_URL、UPSTASH_REDIS_REST_TOKEN
# 数据库：DATABASE_URL、POSTGRES_*
# 其他：ADMIN_ORIGIN、PUBLIC_SITE_ORIGIN
# VERCEL_ENV、VERCEL_URL、VERCEL_PROJECT_ID、VERCEL_GIT_COMMIT_SHA 由平台自动注入，不要手填。
