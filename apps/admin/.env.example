# 无数据库配置：博客、/admin/ 和 /api/ 一起部署在根 Vercel 项目 firefly。
# 详细说明：docs/nocticur/environment-variables.md
# 只在 Production 填生产值；不要把秘密提交到 Git。

# 生产基础必填：后台密码与 Upstash Redis（Vercel Marketplace 集成）。
# Upstash 只当 KV 用，不是关系型数据库；也接受 UPSTASH_REDIS_REST_URL/TOKEN 别名。
# KV_REST_API_URL 只填 Endpoint，如 https://xxx.upstash.io，不要带 /redis、/set/... 或控制台地址。
ADMIN_ENTRY_PASSWORD=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 图片上传与外链导入走 CloudFlare-ImgBed；使用媒体库时 IMGBED_API_TOKEN 必填。
IMGBED_BASE_URL=https://image.nocticur.eu.cc
IMGBED_API_TOKEN=

# 导入和发布文章时，按需取消注释并填服务商凭据。
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_INSTALLATION_ID=        # 可选，自动查询
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=                # 可选，团队项目
# VERCEL_AUTOMATION_BYPASS_SECRET=  # 可选，生产域名启用 Deployment Protection 时

# 接收友链申请或启用本站评论时需要同一 Turnstile 小组件的公钥与私钥。
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# INTERACTION_HASH_SECRET=       # 可选，默认复用 TURNSTILE_SECRET_KEY
# ENABLE_PUBLIC_COMMENTS=        # 可选 true/false
# MEDIA_IMPORT_HOSTS=            # 可选，逗号分隔；默认博客域名与已发布图片主机

# 每日维护 Cron：启用时必须配置，接口以 Bearer 校验。
# CRON_SECRET=

# 生产发布和维护在后台“服务设置”中开启，默认全部关闭。
# 开关保存在 KV 状态中；不再使用 ENABLE_PRODUCTION_* 环境变量。
# 开发/预览可选独立 KV：ADMIN_DEV_KV_REST_API_URL/TOKEN、ADMIN_PREVIEW_KV_REST_API_URL/TOKEN；
# 不填时使用内存存储，重启清空，且不能与生产共用。
# Vercel 自动提供 VERCEL_ENV、VERCEL_URL、VERCEL_PROJECT_PRODUCTION_URL、VERCEL_PROJECT_ID、
# VERCEL_GIT_COMMIT_SHA、VERCEL；无需手填仓库名、GitHub installation ID 或 Vercel project ID。
